{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },

  // The browser half is checked separately, by tsconfig.client.json, against a
  // different set of globals. Keeping DOM out of this project is what stops
  // server code from quietly referencing `document`, and keeping `bun` out of
  // that one stops client code from referencing `Bun`.
  "include": ["src", "test"],
  "exclude": ["src/client"]
}
